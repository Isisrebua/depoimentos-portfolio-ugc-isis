node_modules/

# Segredos reais (URL + chave do Supabase) — nunca vão pro GitHub. Use
# .env.example como modelo; no Render, essas mesmas variáveis são
# configuradas na aba "Environment" do serviço, não em arquivo.
.env

# leads.json/depoimentos.json/uploads/ não existem mais — leads e
# depoimentos (com logo/vídeo) vivem no Supabase (ver lib/leads.js,
# lib/depoimentos.js, supabase/migration-vercel.sql). Entradas mantidas
# como histórico caso algum arquivo velho ainda esteja no disco local.
leads.json
depoimentos.json
uploads/

# Vídeos de Cases de Sucesso — 6 arquivos .mov, ~560MB no total, 3 deles
# sozinhos já passam do limite de 100MB por arquivo do GitHub (bloqueio
# automático do push). Hospede em outro lugar (YouTube não-listado, Vimeo,
# Cloudinary etc.) e troque o /api/videos por essas URLs quando for a vez —
# não é isso que está bloqueando o depoimento.html hoje.
videos/

server.log
